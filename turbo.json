{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {}
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "NEXT_PUBLIC_API_URL",
    "WEB_ORIGIN",
    "API_PORT",
    "PORT"
  ]
}
