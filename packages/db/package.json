{
  "name": "@salary/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed",
    "seed": "dotenv -e ../../.env -- tsx src/seed/run.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:ci": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6",
    "@prisma/client": "^6.1.0",
    "@salary/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
