# Database connection string (e.g. Neon or local Postgres)
DATABASE_URL="postgresql://user:password@ep-host-pooler.c-2.eu-west-2.aws.neon.tech/salary?sslmode=require"

# API Port (Railway injects PORT automatically in production)
PORT=4000
API_PORT=4000

# Allowed frontend origins for CORS (comma separated, e.g. "https://your-app.vercel.app,http://localhost:3000")
WEB_ORIGIN="http://localhost:3000"

# Used by Next.js web frontend to call the NestJS API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Used by local API integration tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salary_test?schema=public"
