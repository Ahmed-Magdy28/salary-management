{
  "name": "salary-management",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@salary/api",
    "start:api": "node apps/api/dist/main.js",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @salary/db generate",
    "db:migrate": "pnpm --filter @salary/db migrate",
    "db:seed": "pnpm --filter @salary/db seed",
    "db:migrate:deploy": "pnpm --filter @salary/db exec dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed:if-empty": "pnpm --filter @salary/db exec dotenv -e ../../.env -- tsx src/seed/run.ts --if-empty",
    "db:seed:ci": "pnpm --filter @salary/db seed:ci"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
